<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:centerColor="@color/launcher_background_mid"
                android:endColor="@color/launcher_background_end"
                android:startColor="@color/launcher_background" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:centerX="0.88"
                android:centerY="0.12"
                android:endColor="@color/launcher_background_glow_clear"
                android:gradientRadius="420dp"
                android:startColor="@color/launcher_background_glow_blue"
                android:type="radial" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:centerX="0.08"
                android:centerY="0.78"
                android:endColor="@color/launcher_background_glow_clear"
                android:gradientRadius="360dp"
                android:startColor="@color/launcher_background_glow_teal"
                android:type="radial" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:centerX="0.68"
                android:centerY="1.0"
                android:endColor="@color/launcher_background_glow_clear"
                android:gradientRadius="430dp"
                android:startColor="@color/launcher_background_glow_violet"
                android:type="radial" />
        </shape>
    </item>
</layer-list>
